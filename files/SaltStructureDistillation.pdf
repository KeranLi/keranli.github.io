<rdf:Description rdf:about="">
<dc:identifier></dc:identifier>
<dc:title>Salt structure identification based on U-net model with target flip, multiple distillation and self-distillation methods</dc:title>
<prism:doi></prism:doi>
<prism:url></prism:url>
<dc:creator><rdf:Bag><rdf:li>Keran Li</rdf:li>
<rdf:li>Jinmin Song</rdf:li>
<rdf:li>Shun Xia</rdf:li>
<rdf:li>Beiwei Luo</rdf:li>
<rdf:li>Junke Wang</rdf:li>
